# Copy to .env and fill in. Never commit .env.
DOMAIN=news.example.com
TZ=America/Denver
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- used by scripts/ ---
# Public key for backup encryption (from `age-keygen`). The PRIVATE key stays
# offline — treat it like a seed phrase; without it backups are unreadable.
AGE_RECIPIENT=age1CHANGEME

# Optional dead-man switch: a healthchecks.io (or similar) ping URL.
# Backups curl it on success; you get an email only when backups STOP working.
HEALTHCHECK_URL=

# Optional offsite copy of encrypted backups (rclone remote:path). Empty = local only.
RCLONE_DEST=

# Listmonk API credentials (Admin → Users → API user) for automation scripts.
LISTMONK_URL=https://news.example.com
LISTMONK_API_USER=automation
LISTMONK_API_TOKEN=CHANGE_ME

# RSS-to-campaign
SITE_FEED_URL=https://illithics.github.io/the-device-layer-website/feed.xml
LIST_ID=1
# false = create a DRAFT campaign and stop (you press send after eyeballing it).
# true  = schedule the campaign to send immediately. Start with false.
AUTO_SEND=false

# Data retention: unsubscribed/blocklisted rows older than this are purged monthly.
RETENTION_DAYS=30
